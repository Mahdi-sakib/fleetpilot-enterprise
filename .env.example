PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# MySQL connection. For local dev, run a local MySQL (e.g.
# `docker run -d -e MYSQL_ROOT_PASSWORD=test -p 3307:3306 mysql:8`) and use
# matching values below. The database itself is created automatically if it
# doesn't exist and the user has CREATE privilege.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=test
DB_NAME=fleetpilot

# Optional: enables "Continue with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with this redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional: real email delivery for OTP/password-reset emails.
# Without these set, emails are logged to the server console instead.
# Note: hosts that block outbound SMTP (e.g. GoDaddy Node.js Hosting) need
# an HTTP-based email API instead — SMTP won't be reachable from there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FleetPilot Enterprise <no-reply@fleetpilot.local>"
