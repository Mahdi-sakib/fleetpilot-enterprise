PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Optional: enables "Continue with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with this redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional: real email delivery for OTP/password-reset emails.
# Without these set, emails are logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FleetPilot Enterprise <no-reply@fleetpilot.local>"
